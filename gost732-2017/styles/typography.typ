// Неразрывная типографика: связки «число + единица», диапазоны, ссылки,
// названия моделей и размеры не разрываются переносом строки.
// Включается флагом фича-неразрывные-величины (по умолчанию выключено,
// тк box() мешает равномерной растяжке пробелов при justify).

// Список единиц измерения по умолчанию. Порядок важен: длинные варианты
// идут раньше коротких (МГц перед Гц, мА перед А), иначе короткий
// перехватит часть длинного. Расширяется параметром единицы.
#let единицы-по-умолчанию = (
  "кГц", "МГц", "Гц",
  "кВт", "Вт", "кВ", "мВ", "В",
  "мкА", "мА", "А",
  "кОм", "МОм", "Ом",
  "кг", "мм", "см", "мкм", "нм",
  "мкс", "мс", "нс",
  "мкФ", "нФ", "пФ", "мкГн",
  "КБ", "МБ", "ГБ", "кБ",
  "байта", "байтов", "байт", "бит", "бод",
  "°C",
  "об/мин", "об/с", "м/с", "рад/с",
  "Кбит/с", "кбит/с", "бит/с",
  "FPS", "пикселей", "пикселя", "пиксель",
  "Н",
)

#let style_typography(единицы: единицы-по-умолчанию, content) = {
  // обычный и неразрывный пробелы — оба склеиваем в неразрывный блок
  let пробел = " \u{00A0}"
  let единицы-re = единицы.join("|")

  // число + единица измерения («45 Гц», «3,5 В») не отрывается
  show regex("[0-9]+(?:[.,][0-9]+)?[" + пробел + "](?:" + единицы-re + ")\b"): it => box(it)

  // числовой диапазон («45-50», «15--20») не рвётся
  show regex("[0-9]+(?:--|—|–|-)[0-9]+"): it => box(it)

  // размеры вида 8x8x8 → латинская x заменяется на знак умножения
  show regex("[0-9]+x[0-9]+(?:x[0-9]+)?"): it => box(it.text.replace("x", sym.times))

  // ссылки на рисунки/таблицы/приложения («рисунок 5») целиком
  show ref: it => box(it)

  // названия моделей (L298N, ESP32-S2, WS2812B) не рвутся внутри по дефису
  show regex("[A-ZА-Я][A-Za-zА-Яа-я]*[0-9][A-Za-z0-9-]*"): it => box(it)

  // название модели не отрывается от предшествующего слова («драйвер L298N»)
  show regex("[А-Яа-яёA-Za-z]{3,}[" + пробел + "][A-ZА-Я][A-Za-z]*[0-9][A-Za-z0-9-]*"): it => box(it)

  content
}
