#import "../g7.32-2017.config.typ": config

// Полностраничная вставка готового листа (скан, выгрузка из Word, копия
// чертежа, страница PDF) с полями документа по ГОСТ.
//
// Закрывает типовую задачу: вставить титул ТЗ / задание / приложение как
// картинку или PDF так, чтобы TestVkr не ругался на поля и номер страницы.
//
//   данные        — содержимое листа, обычно image("scan.jpeg", width: 100%)
//                    или встроенная страница PDF (с typst 0.14: image(...))
//   скрыть-номер  — номер страницы остаётся в текстовом слое (TestVkr его
//                    видит), но печатается белым и визуально не мешает скану
//   повернуто     — повернуть лист на 90° (для листов формата А1 и т.п.)
//   поля          — поля страницы; по умолчанию поля документа

#let insert-sheet(
  данные,
  скрыть-номер: false,
  повернуто: false,
  поля: auto,
) = {
  let номер = context {
    let n = counter(page).get().first()
    set text(size: config.page.textSize, fill: if скрыть-номер { white } else { black })
    align(config.page.alignNum)[#n]
  }

  page(
    margin: if поля == auto { config.page.margin } else { поля },
    header: none,
    footer: номер,
  )[
    #align(center + top)[
      #if повернуто {
        rotate(-90deg, reflow: true, данные)
      } else {
        данные
      }
    ]
  ]
}

#let вставить-лист(
  данные,
  скрыть-номер: false,
  повернуто: false,
  поля: auto,
) = insert-sheet(
  данные,
  скрыть-номер: скрыть-номер,
  повернуто: повернуто,
  поля: поля,
)
