#import "../gost732-2017/g7.32-2017.typ": *
#show: гост732-2017.with(фича-маленький-отступ-вокруг-таблиц: да)

= Раздел

// Длинная таблица (60 строк) гарантированно перетекает на стр.2+, где
// печатается «Продолжение таблицы 1». Маркеры данных СД* — уникальны,
// чтобы измерить зазор между надписью продолжения и первой строкой тела.
#таблица(table(
  columns: 2,
  [N], [Описание],
  ..range(60).map(i => ([СД#(i+1)], [строка#(i+1)])).flatten()
))[Длинный перечень]
