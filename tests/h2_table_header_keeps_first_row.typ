#import "../gost732-2017/g7.32-2017.typ": *
#show: гост732-2017.with(фича-маленький-отступ-вокруг-таблиц: да)

= Раздел

// #v подобран компиляцией так, что подпись «Таблица 1» и строка-шапка
// «Заголовок|Значение» влезают внизу стр.1, а первая ЧИСЛОВАЯ строка
// данных СТРОКА1 уже не помещается и уезжает на стр.2.
#v(650pt)

#таблица(table(
  columns: 2,
  [Заголовок], [Значение],
  ..range(20).map(i => ([СТРОКА#(i+1)], [#(i*10)])).flatten()
))[Параметры]
