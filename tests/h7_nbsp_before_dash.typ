#import "../gost732-2017/g7.32-2017.typ": *
#show: гост732-2017.with(фича-неразрывные-величины: да)

// Узкий box ровно такой ширины (26pt), что БЕЗ склейки тире уехало бы на
// отдельную строку (проверено компиляцией: без флага получаем 'блок' / '—'
// на разных yMin). С флагом неразрывный пробел перед тире держит '— ' на
// одной строке с предшествующим словом. nbsp в pdftotext нормализуется в
// пробел, поэтому проверка ФУНКЦИОНАЛЬНАЯ — по равенству yMin.
#box(width: 26pt)[
  блок —
]
