#show: гост732-2017

// Приложение с собственной-нумерацией: true. Внутри приложения footer
// нумеруется заново от 1 (страницы приложения «своя нумерация»), тогда как
// основная часть продолжает сквозную нумерацию.
//
// Делаем основную часть на несколько страниц, затем приложение на
// несколько страниц. Ожидаем: footer первой содержательной страницы
// приложения == "1" (собственная нумерация), и далее монотонно внутри.

= Раздел один
#lorem(60)
#pagebreak()
= Раздел два
#lorem(60)
#pagebreak()
= Раздел три
#lorem(60)

#приложение(буква: "А", содержание: [Большое приложение], собственная-нумерация: true)[
  #lorem(80)
  #pagebreak()
  #lorem(80)
  #pagebreak()
  #lorem(80)
]
