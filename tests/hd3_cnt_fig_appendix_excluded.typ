#import "../gost732-2017/g7.32-2017.typ": *
#show: гост732-2017

// Реферат по ГОСТ 7.32-2017 считает иллюстрации ОСНОВНОЙ части.
// Рисунки в приложениях нумеруются заново (А.1, А.2) и в реферат
// «Документ содержит N иллюстраций» НЕ входят.
// Здесь: 3 рисунка в основной части + 2 рисунка в приложении.
// Ожидаем #колво-рисунков == 3 (приложенческие не считаются).

маркеррис #колво-рисунков маркеррис

= Раздел

#рис(rect(width: 4cm, height: 2cm))[Первая схема основной части]

#рис(rect(width: 4cm, height: 2cm))[Вторая схема основной части]

#рис(rect(width: 4cm, height: 2cm))[Третья схема основной части]

#приложение(буква: "А", содержание: [Доп. иллюстрации])[
  #рис(rect(width: 4cm, height: 2cm))[Схема приложения один]

  #рис(rect(width: 4cm, height: 2cm))[Схема приложения два]
]
