= Раздел

// Вложенная таблица (table в ячейке) — пакет не должен падать, и
// continuation-логика внешней таблицы не должна порождать «Продолжение»
// из-за внутренней table. Должна быть ровно ОДНА подпись «Таблица 1».
#таблица(table(
  columns: 2,
  [ВНЕШНЯЯЛЕВ], table(columns: 2, [внв1], [внв2], [внв3], [внв4]),
  [ВНЕШНЯЯНИЗ], [обычная],
))[Вложенная таблица]
