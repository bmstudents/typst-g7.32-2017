#import "../gost732-2017/g7.32-2017.typ": *
#show: гост732-2017.with(фича-неразрывные-величины: да)

// Box 95pt: 'ааааааааа' (переносимое слово) занимает первую строку, связка
// 'драйвер L298N' (~78pt) встаёт целиком на вторую. БЕЗ флага typst рвёт
// 'драй-вер' и отрывает модель; С флагом неразрывный пробел держит
// 'драйвер' и 'L298N' на одной строке.
#box(width: 95pt)[
  ааааааааа драйвер L298N
]
